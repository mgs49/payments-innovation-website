---
layout: base.njk
---
<article class="page has-head{% if wide %} page-wide{% endif %}">
  <header class="page-head">
    <div class="wrap">
      {%- if parent %}<p class="crumb"><a href="{{ parent.url }}">{{ parent.title }}</a></p>{% endif %}
      <h1>{{ title }}</h1>
      {%- if lede %}<p class="lede">{{ lede }}</p>{% endif %}
    </div>
  </header>
  <div class="wrap">
    <div class="prose">
{{ content | safe }}
    </div>
  </div>
</article>
