<!doctype html>
<html lang="en-GB" class="alt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.title %}{{ title }} - {% endif %}{{ site.title }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
{% if redirect %}<meta http-equiv="refresh" content="0; url={{ redirect }}"><link rel="canonical" href="{{ redirect }}">{% endif %}
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
{#- Link preview: what LinkedIn, WhatsApp, e-mail apps etc. show when the address is shared. Absolute addresses use the live domain. #}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{% if title and title != site.title %}{{ title }} - {% endif %}{{ site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/link-preview.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Payments Innovation Consulting - Regulation and technology-driven digital finance innovation">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="/assets/css/site.css">
<link rel="stylesheet" href="/assets/css/alt.css">
</head>
<body id="top"{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">
      <span class="brand-name">Payments Innovation Consulting</span>
      <span class="brand-tag">Dr Michael Salmony</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
      {%- for item in nav.links %}
        <li><a href="{{ item.url }}"{% if page.url | startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-row">
    <p>Payments Innovation Consulting</p>
    <ul>
      <li><a href="{{ site.linkedin }}" rel="me">LinkedIn</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/impressum/">Impressum</a></li>
      <li><a href="/privacy-policy/">Privacy policy</a></li>
    </ul>
  </div>
</footer>
<script>
/* E-mail addresses are put together in the browser, so that address-collecting robots reading the page source do not find them. */
document.querySelectorAll(".mail").forEach(function (e) {
  var r = function (t) { return t.split("").reverse().join(""); };
  var a = r(e.getAttribute("data-u")) + "@" + r(e.getAttribute("data-d"));
  var s = e.getAttribute("data-subject");
  var l = document.createElement("a"); l.href = "mailto:" + a + (s ? "?subject=" + encodeURIComponent(s) : ""); l.textContent = a;
  e.replaceWith(l);
});
</script>
<script>
/* YouTube videos: a still picture until the visitor presses play; only then is the player loaded. */
document.addEventListener("click", function (e) {
  var a = e.target.closest && e.target.closest("a[data-yt]"); if (!a) return;
  e.preventDefault();
  var f = document.createElement("iframe");
  f.src = "https://www.youtube-nocookie.com/embed/" + a.getAttribute("data-yt") + "?autoplay=1";
  f.title = a.getAttribute("title") || "Video";
  f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
  f.allowFullscreen = true;
  a.parentNode.replaceChild(f, a);
});
</script>
<a href="#top" class="to-top" id="to-top">&uarr; Top</a>
<script>
/* "Top" button: shown after scrolling down, scrolls back to the top of the page. */
(function () {
  var b = document.getElementById("to-top");
  function f() { b.classList.toggle("show", window.scrollY > 800); }
  window.addEventListener("scroll", f, { passive: true }); f();
  b.addEventListener("click", function (ev) { ev.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); });
})();
</script>
</body>
</html>
